<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cn.xiaolin</groupId>
        <artifactId>magic-video-backend</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <!--打包为pom-->
    <packaging>pom</packaging>

    <artifactId>common</artifactId>
    <name>common</name>
    <description>公共子模块</description>

    <modules>
        <module>common-message</module>
        <module>common-db</module>
    </modules>

    <dependencies>


        <!--Spring Cloud-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <!--
          注意：这里曾声明 spring-cloud-config-server 与 spring-cloud-starter-config。
          本项目已彻底移除配置中心（配置随 jar 走，见 ADR-0008），
          留着 config client 只会让它在每次启动时去连默认的 http://localhost:8888。
          bootstrap 上下文由 platform-web 的 spring-cloud-starter-bootstrap 提供，删掉这两个不影响。
        -->

        <!--Apache工具类-->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>3.18.0</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>


    </dependencies>


</project>
