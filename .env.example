# ====================================================================
# Magic Video Backend - Environment Variables Template
# ====================================================================
# Copy this file to `.env` and fill in real credentials for production.
# NEVER commit the real `.env` file. The values below are dev-only
# defaults consumed by Spring Cloud bootstrap files and docker-compose.
# ====================================================================

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=change-me-mysql

# ---------- RabbitMQ ----------
RABBITMQ_DEFAULT_USER=change-me-rabbit-user
RABBITMQ_DEFAULT_PASS=change-me-rabbit-pass
RABBITMQ_DEFAULT_VHOST=/change-me-vhost

# ---------- MinIO (root credentials for buckets) ----------
MINIO_ROOT_USER=change-me-minio-user
MINIO_ROOT_PASSWORD=change-me-minio-pass

# ---------- MinIO per-service credentials (access-key / secret-key) ----------
MINIO_ACCESS_KEY=change-me-access-key
MINIO_SECRET_KEY=change-me-secret-key

# ---------- Aliyun SMS (used by common-utils SMSUtils) ----------
SMS_ACCESS_KEY_ID=change-me-sms-ak
SMS_ACCESS_SECRET=change-me-sms-sk

# ---------- Volume mount paths (local dev only) ----------
# MYSQL_DATA=...
# MULTIMEDIA_MINIO_DATA=...
# HAS_MINIO_DATA=...
# LOKI_MINIO_DATA=...